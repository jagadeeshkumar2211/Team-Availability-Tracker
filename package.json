{
  "name": "teamconnect",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "npm --prefix frontend run build",
    "start": "npm run build && npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}